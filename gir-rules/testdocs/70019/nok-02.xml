<?xml version="1.0" encoding="UTF-8"?>
<!-- A single CE carries both GIR305 and GIR306 (the case 70018 forbids) and is
     the only CE. There is no *other* CE with GIR306, so the rule must fail on
     its own — without relying on 70018 to rule out the same-CE GIR306. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:GeneralSection>
      <globe:CorporateStructure>
        <globe:CE>
          <globe:ID>
            <globe:GlobeStatus>GIR305</globe:GlobeStatus>
            <globe:GlobeStatus>GIR306</globe:GlobeStatus>
          </globe:ID>
        </globe:CE>
      </globe:CorporateStructure>
    </globe:GeneralSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
