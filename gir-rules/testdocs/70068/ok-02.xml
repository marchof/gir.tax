<?xml version="1.0" encoding="UTF-8"?>
<!-- Year in the same year as Period Start is allowed ("correspond to or be before").
     The Year's date (09-30) is later in the calendar than Period Start (01-01) but the
     same year, so it passes under the year comparison and would fail a full-date one. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:FilingInfo>
      <globe:Period>
        <globe:Start>2024-01-01</globe:Start>
        <globe:End>2024-12-31</globe:End>
      </globe:Period>
    </globe:FilingInfo>
    <globe:JurisdictionSection>
      <globe:GLoBETax>
        <globe:ETR>
          <globe:ETRStatus>
            <globe:ETRComputation>
              <globe:OverallComputation>
                <globe:AdjustedCoveredTax>
                  <globe:PostFilingAdjust>
                    <globe:CoveredTaxRefund>
                      <globe:AmountAttributed>
                        <globe:Year>2024-09-30</globe:Year>
                      </globe:AmountAttributed>
                    </globe:CoveredTaxRefund>
                  </globe:PostFilingAdjust>
                </globe:AdjustedCoveredTax>
              </globe:OverallComputation>
            </globe:ETRComputation>
          </globe:ETRStatus>
        </globe:ETR>
      </globe:GLoBETax>
    </globe:JurisdictionSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
