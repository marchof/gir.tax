<?xml version="1.0" encoding="UTF-8"?>
<!-- A single CE carries both GIR308 and GIR307 (the case 70014 forbids) and is
     the only CE. There is no *other* CE with GIR307, so the rule must fail on
     its own — without relying on 70014 to rule out the same-CE GIR307. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:GeneralSection>
      <globe:CorporateStructure>
        <globe:CE>
          <globe:ID>
            <globe:GlobeStatus>GIR308</globe:GlobeStatus>
            <globe:GlobeStatus>GIR307</globe:GlobeStatus>
          </globe:ID>
        </globe:CE>
      </globe:CorporateStructure>
    </globe:GeneralSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
