<?xml version="1.0" encoding="UTF-8"?>
<!-- Three CEs: the first CE's Exception/TIN matches the third CE's ID/TIN, with
     the second CE also a sibling candidate — so the match is to a sibling that is
     neither the only candidate nor the first in document order. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:GeneralSection>
      <globe:CorporateStructure>
        <globe:CE>
          <globe:ID>
            <globe:TIN>FIRST555</globe:TIN>
          </globe:ID>
          <globe:QIIR>
            <globe:Exception>
              <globe:TIN>THIRD777</globe:TIN>
            </globe:Exception>
          </globe:QIIR>
        </globe:CE>
        <globe:CE>
          <globe:ID>
            <globe:TIN>SECOND666</globe:TIN>
          </globe:ID>
        </globe:CE>
        <globe:CE>
          <globe:ID>
            <globe:TIN>THIRD777</globe:TIN>
          </globe:ID>
        </globe:CE>
      </globe:CorporateStructure>
    </globe:GeneralSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
