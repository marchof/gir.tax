<?xml version="1.0" encoding="UTF-8"?>
<!-- Self-exclusion: a lone CE whose Exception/TIN equals its OWN ID/TIN. Even
     though the value matches a CE TIN, it must fail because the rule requires
     ANOTHER CE — there is no sibling, so the candidate set is empty. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:GeneralSection>
      <globe:CorporateStructure>
        <globe:CE>
          <globe:ID>
            <globe:TIN>LONE999</globe:TIN>
          </globe:ID>
          <globe:QIIR>
            <globe:Exception>
              <globe:TIN>LONE999</globe:TIN>
            </globe:Exception>
          </globe:QIIR>
        </globe:CE>
      </globe:CorporateStructure>
    </globe:GeneralSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
