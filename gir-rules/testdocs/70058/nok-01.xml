<?xml version="1.0" encoding="UTF-8"?>
<!-- The Art7.6 InvestmentEntityTIN equals the electing CEComputation's own TIN —
     the electing CE and the investment entity must be different. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:JurisdictionSection>
      <globe:GLoBETax>
        <globe:ETR>
          <globe:ETRStatus>
            <globe:ETRComputation>
              <globe:CEComputation>
                <globe:TIN>SAMECE333</globe:TIN>
                <globe:Elections>
                  <globe:Art7.6>
                    <globe:InvestmentEntityTIN>SAMECE333</globe:InvestmentEntityTIN>
                  </globe:Art7.6>
                </globe:Elections>
              </globe:CEComputation>
            </globe:ETRComputation>
          </globe:ETRStatus>
        </globe:ETR>
      </globe:GLoBETax>
    </globe:JurisdictionSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
