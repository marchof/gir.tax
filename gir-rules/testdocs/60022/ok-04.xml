<?xml version="1.0" encoding="UTF-8"?>
<!-- Role is not GIR401 (the UPE is not the filer), so the FilingCE TIN need not match a
     UPE TIN -> rule does not apply. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:FilingInfo>
      <globe:FilingCE>
        <globe:TIN>ZZZ</globe:TIN>
        <globe:Role>GIR402</globe:Role>
      </globe:FilingCE>
    </globe:FilingInfo>
    <globe:GeneralSection>
      <globe:CorporateStructure>
        <globe:UPE>
          <globe:ExcludedUPE>
            <globe:ID>
              <globe:TIN>T123</globe:TIN>
            </globe:ID>
          </globe:ExcludedUPE>
        </globe:UPE>
      </globe:CorporateStructure>
    </globe:GeneralSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
