<?xml version="1.0" encoding="UTF-8"?>
<!-- Guard false (OwnershipType != GIR801): the rule is vacuous, so an Ownership/TIN
     matching no UPE TIN must still pass. The deliberately non-matching TIN would
     start failing if the when: guard were ever dropped. -->
<globe:GLOBE_OECD xmlns:globe="urn:oecd:ties:globe:v2">
  <globe:GLOBEBody>
    <globe:GeneralSection>
      <globe:CorporateStructure>
        <globe:CE>
          <globe:Ownership>
            <globe:OwnershipType>GIR802</globe:OwnershipType>
            <globe:TIN>NOMATCH999</globe:TIN>
          </globe:Ownership>
        </globe:CE>
      </globe:CorporateStructure>
    </globe:GeneralSection>
  </globe:GLOBEBody>
</globe:GLOBE_OECD>
